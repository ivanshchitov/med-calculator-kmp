# Copy this file to .env and fill in the values.
# .env is ignored by git, do not commit real credentials.

# Yandex Cloud Object Storage static access key.
# Console: Object Storage -> service account -> "Static access key".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Target bucket and region.
YC_S3_BUCKET=medcalculatorapp.ru
AWS_DEFAULT_REGION=ru-central1
YC_S3_ENDPOINT=https://storage.yandexcloud.net

# Public site URL, printed after a successful deploy.
PWA_PUBLIC_URL=https://medcalculatorapp.ru
